# =============================================================================
# PETROLHEAD - Fuel Station Profile Dashboard Configuration
# =============================================================================

# --- API Keys ---
GEMINI_API_KEY=AIzaS...
PERPLEXITY_API_KEY=pplx-LZVWh...

# --- Google Cloud Project ---
GCP_PROJECT_NAME=projects/882...
GCP_PROJECT_NUMBER=882...

# --- Supabase (Optional) ---
SUPABASE_URL=https://nlz...uh.supabase.co
SUPABASE_KEY=sb_publishable_NNxKl...
SUPABASE_ENABLED=true

# --- Provider Configuration ---
# Primary provider: "gemini" or "perplexity"
# DEV: set to "perplexity" to save Gemini budget
# PROD/INTERVIEW: set to "gemini"
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDER=perplexity
AUTO_FALLBACK_ENABLED=true

# --- Gemini Configuration ---
GEMINI_DEEP_RESEARCH_AGENT=deep-research-pro-preview-12-2025
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite
GEMINI_THINKING_SUMMARIES=auto
GEMINI_STREAM_ENABLED=true
GEMINI_POLL_INTERVAL_SECONDS=10
GEMINI_MAX_WAIT_MINUTES=20
GEMINI_STORE_INTERACTIONS=true

# --- Perplexity Configuration ---
PERPLEXITY_MODEL=sonar-deep-research
PERPLEXITY_STREAM_ENABLED=true
PERPLEXITY_MAX_TOKENS=100000
PERPLEXITY_REASONING_EFFORT=high

# --- JSON Converter ---
CONVERTER_MODEL=gemini-2.5-flash-lite
CONVERTER_ENABLED=true
CONVERTER_SKIP_IF_JSON=true

# --- Demo Mode ---
DEMO_MODE_ENABLED=true
DEMO_OUTPUTS_DIR=demo_outputs

# --- Output / Logging ---
OUTPUTS_DIR=outputs
LOG_LEVEL=DEBUG
LOG_TO_FILE=true
LOG_FILE_PATH=outputs/logs/petrolhead.log
SAVE_RAW_RESPONSES=true
SAVE_INTERMEDIATE_FILES=true

# --- Server Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=6055
FRONTEND_PORT=5055
CORS_ORIGINS=http://localhost:5055,http://127.0.0.1:5055

# --- Session Configuration ---
SESSION_EXPIRY_HOURS=24
MAX_CONCURRENT_SESSIONS=5

# --- Feature Flags ---
FEATURE_STREAMING_UI=true
FEATURE_PROGRESS_TRACKING=true
FEATURE_COOKIE_PERSISTENCE=true
FEATURE_DEMO_DASHBOARDS=true
FEATURE_LIVE_SEARCH=true
